---
import '../styles/tokens.css';
import '../styles/main.css';
import '../styles/overrides.css';
import '../styles/swiper.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical = 'https://www.indiev.org', noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="M2Ea1fzIt-JrQLXsua5du1CLoN9nycXPJ5Ds7ncnWxA" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/images/webclip.png" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/Mulish-Black.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/Avenir-Light.woff2" crossorigin />
  <!-- Establish consent before any optional third-party tag can run. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
      if (arguments[0] === 'consent' && arguments[1] === 'update') {
        window.dispatchEvent(new CustomEvent('indiev:consent-update', {
          detail: arguments[2] || {}
        }));
      }
    };
    window.gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'functionality_storage': 'denied',
      'personalization_storage': 'denied',
      'security_storage': 'granted'
    });
  </script>
  <!-- The CMP is necessary to collect a choice; GA remains absent until analytics consent. -->
  <script src="https://cmp.kpicreatives.com/v1/embed.js" defer></script>

  <!-- Structured data -->
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@id": "https://www.indiev.org#org",
  "@type": "ProfessionalService",
  "name": "Indiev Video Editors",
  "url": "https://www.indiev.org",
  "description": "Indiev — professional video editing services with unlimited revisions and 24/7 support. We help YouTubers, businesses, and brands turn raw footage into high-quality content.",
  "telephone": "+1-747-677-1203",
  "priceRange": "$$",
  "sameAs": [
    "https://www.youtube.com/@INDIEVORG",
    "https://www.facebook.com/indiev.org",
    "https://www.tiktok.com/@indievorg",
    "https://www.pinterest.com/indievvideoeditors/",
    "https://www.linkedin.com/company/indiev-video-editors/",
    "https://x.com/Indievvideoedit",
    "https://www.instagram.com/indievorg/",
    "https://www.google.com/maps?cid=6481826325447191756"
  ],
  "hasMap": "https://www.google.com/maps?cid=6481826325447191756",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "695 Santa Clara Ave",
    "addressLocality": "Venice",
    "addressRegion": "CA",
    "postalCode": "90291",
    "addressCountry": "US"
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "08:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "08:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Wednesday", "opens": "08:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "08:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "08:00", "closes": "17:00" }
  ],
  "areaServed": [{ "@type": "AdministrativeArea", "name": "United States" }],
  "knowsAbout": ["Video editing", "Post-production", "YouTube editing", "Product video", "Promo video", "Videography packages"]
}
  </script>
  <script type="application/ld+json" is:inline>
{ "@context": "https://schema.org", "@type": "WebSite", "url": "https://www.indiev.org", "name": "Indiev Video Editors", "publisher": { "@id": "https://www.indiev.org#org" } }
  </script>
</head>
<body>
  <slot />

  <!-- Swiper (self-hosted, non-blocking) -->
  <script is:inline>
    if (!/[?&]noswiper=1/.test(location.search)) {
      var swiperScript = document.createElement('script');
      swiperScript.src = '/vendor/swiper/swiper-bundle.min.js';
      swiperScript.onload = function () { document.dispatchEvent(new Event('swiper:ready')); };
      document.head.appendChild(swiperScript);
    }
  </script>

  <!-- Site interactions -->
  <script>
    import '../scripts/main.js';
  </script>

  <!-- Cal.com facade: lightweight button, real embed (book.kpicreatives.com) loads only on click -->
  <button id="cal-fab" type="button" aria-label="Schedule a Call">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 16H5V10h14v10ZM5 8V6h14v2H5Z" fill="currentColor"/></svg>
    Schedule a Call
  </button>
  <style is:inline>
    #cal-fab {
      position: fixed; right: 20px; bottom: 20px; z-index: 10001;
      display: inline-flex; align-items: center; gap: 8px;
      background: #7b5be9; color: #fff; border: 0; cursor: pointer;
      border-radius: 9999px; padding: 14px 22px;
      font-family: inherit; font-size: 16px; font-weight: 700; line-height: 1;
      box-shadow: 0 4px 14px rgba(0,0,0,.25);
      transition: transform .15s ease, box-shadow .15s ease;
    }
    #cal-fab:hover { transform: scale(1.04); box-shadow: 0 6px 18px rgba(0,0,0,.3); }
  </style>
  <script is:inline>
    (function () {
      var btn = document.getElementById('cal-fab');
      var inited = false;
      btn.addEventListener('click', function () {
        if (!inited) {
          inited = true;
          (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://book.kpicreatives.com/embed/embed.js", "init");
          Cal("init", { origin: "https://book.kpicreatives.com" });
          Cal("ui", { styles: { branding: { brandColor: "#7b5be9" } }, hideEventTypeDetails: false });
        }
        Cal("modal", { calLink: "dima/qualification-15" });
      });
    })();
  </script>

  <!-- Basic consent mode: GA4 is not requested until analytics consent is granted. -->
  <script is:inline>
    (function () {
      var measurementId = 'G-F3NVLVT8FX';
      var analyticsGranted = false;
      var analyticsLoaded = false;
      var analyticsDisabledKey = 'ga-disable-' + measurementId;
      var thirdPartyDisabled = /[?&]nothird=1/.test(location.search);

      // Block measurement defensively until the CMP emits an explicit grant.
      window[analyticsDisabledKey] = true;

      function loadAnalytics() {
        if (analyticsLoaded || !analyticsGranted || thirdPartyDisabled) return;
        analyticsLoaded = true;
        window[analyticsDisabledKey] = false;

        var ga = document.createElement('script');
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(measurementId);
        ga.async = true;
        document.head.appendChild(ga);

        window.gtag('js', new Date());
        window.gtag('config', measurementId);

        if (location.href.indexOf('calendly') !== -1) {
          window.gtag('event', 'Page calendly');
        }
      }

      window.addEventListener('indiev:consent-update', function (event) {
        analyticsGranted = event.detail.analytics_storage === 'granted';
        window[analyticsDisabledKey] = !analyticsGranted;
        if (analyticsGranted) loadAnalytics();
      });

      // --- GA4 events, migrated 1:1 from the GTM container ---
      // price_card_button: click on a .price_card_button element
      // book_scroll: click on the "Schedule a Call" button (was .calendly-badge-content)
      document.addEventListener('click', function (e) {
        if (!analyticsGranted || !analyticsLoaded) return;
        var el = e.target && e.target.closest ? e.target : null;
        if (!el) return;
        if (el.closest('.price_card_button')) window.gtag('event', 'price_card_button');
        if (el.closest('#cal-fab, .calendly-badge-content')) window.gtag('event', 'book_scroll');
      }, true);
      // "Form submit": any form; "Subscribe_form": the #email-form newsletter form
      document.addEventListener('submit', function (e) {
        if (!analyticsGranted || !analyticsLoaded) return;
        window.gtag('event', 'Form submit');
        if (e.target && e.target.id === 'email-form') window.gtag('event', 'Subscribe_form');
      }, true);
    })();
  </script>
</body>
</html>
