---
import '../styles/tokens.css';
import '../styles/main.css';
import '../styles/overrides.css';
import '../styles/swiper.css';
import ClosureBanner from '../components/ClosureBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical = 'https://www.indiev.org', noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="M2Ea1fzIt-JrQLXsua5du1CLoN9nycXPJ5Ds7ncnWxA" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/images/webclip.png" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/Mulish-Black.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/Avenir-Light.woff2" crossorigin />
  <!-- Establish consent before any optional third-party tag can run. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
      if (arguments[0] === 'consent' && arguments[1] === 'update') {
        window.dispatchEvent(new CustomEvent('indiev:consent-update', {
          detail: arguments[2] || {}
        }));
      }
    };
    window.gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'functionality_storage': 'denied',
      'personalization_storage': 'denied',
      'security_storage': 'granted'
    });
  </script>
  <!-- The CMP is necessary to collect a choice; GA remains absent until analytics consent. -->
  <script src="https://cmp.kpicreatives.com/v1/embed.js" defer></script>

  <!-- Structured data -->
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@id": "https://www.indiev.org#org",
  "@type": "ProfessionalService",
  "name": "Indiev Video Editors",
  "url": "https://www.indiev.org",
  "description": "Indiev was a video editing service based in Venice, Los Angeles, operated by KPI Creatives. It ceased operations on October 30, 2026; its articles remain available as a public resource.",
  "dissolutionDate": "2026-10-30",
  "parentOrganization": { "@type": "Organization", "name": "KPI Creatives", "url": "https://www.kpicreatives.com" },
  "founder": [
    { "@type": "Person", "name": "Yaro Korets", "url": "https://korets.net", "sameAs": ["https://korets.net", "https://growthcontrol.app"] },
    { "@type": "Person", "name": "Dmytro Pavlenko", "url": "https://www.linkedin.com/in/pavlenkodmytro/", "sameAs": ["https://www.linkedin.com/in/pavlenkodmytro/"] }
  ],
  "sameAs": [
    "https://www.youtube.com/@INDIEVORG",
    "https://www.facebook.com/indiev.org",
    "https://www.tiktok.com/@indievorg",
    "https://www.pinterest.com/indievvideoeditors/",
    "https://www.linkedin.com/company/indiev-video-editors/",
    "https://x.com/Indievvideoedit",
    "https://www.instagram.com/indievorg/",
    "https://www.google.com/maps?cid=6481826325447191756"
  ],
  "hasMap": "https://www.google.com/maps?cid=6481826325447191756",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "695 Santa Clara Ave",
    "addressLocality": "Venice",
    "addressRegion": "CA",
    "postalCode": "90291",
    "addressCountry": "US"
  },
  "areaServed": [{ "@type": "AdministrativeArea", "name": "United States" }],
  "knowsAbout": ["Video editing", "Post-production", "YouTube editing", "Product video", "Promo video", "Videography packages"]
}
  </script>
  <script type="application/ld+json" is:inline>
{ "@context": "https://schema.org", "@type": "WebSite", "url": "https://www.indiev.org", "name": "Indiev Video Editors", "publisher": { "@id": "https://www.indiev.org#org" } }
  </script>
</head>
<body>
  <ClosureBanner />
  <slot />

  <!-- Swiper (self-hosted, non-blocking) -->
  <script is:inline>
    if (!/[?&]noswiper=1/.test(location.search)) {
      var swiperScript = document.createElement('script');
      swiperScript.src = '/vendor/swiper/swiper-bundle.min.js';
      swiperScript.onload = function () { document.dispatchEvent(new Event('swiper:ready')); };
      document.head.appendChild(swiperScript);
    }
  </script>

  <!-- Site interactions -->
  <script>
    import '../scripts/main.js';
  </script>

  <!-- Basic consent mode: GA4 is not requested until analytics consent is granted. -->
  <script is:inline>
    (function () {
      var measurementId = 'G-F3NVLVT8FX';
      var analyticsGranted = false;
      var analyticsLoaded = false;
      var analyticsDisabledKey = 'ga-disable-' + measurementId;
      var thirdPartyDisabled = /[?&]nothird=1/.test(location.search);

      // Block measurement defensively until the CMP emits an explicit grant.
      window[analyticsDisabledKey] = true;

      function loadAnalytics() {
        if (analyticsLoaded || !analyticsGranted || thirdPartyDisabled) return;
        analyticsLoaded = true;
        window[analyticsDisabledKey] = false;

        var ga = document.createElement('script');
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(measurementId);
        ga.async = true;
        document.head.appendChild(ga);

        window.gtag('js', new Date());
        window.gtag('config', measurementId);
      }

      window.addEventListener('indiev:consent-update', function (event) {
        analyticsGranted = event.detail.analytics_storage === 'granted';
        window[analyticsDisabledKey] = !analyticsGranted;
        if (analyticsGranted) loadAnalytics();
      });

    })();
  </script>
</body>
</html>
