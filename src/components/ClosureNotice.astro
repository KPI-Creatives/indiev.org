---
interface Props {
  heading?: string;
  as?: 'h1' | 'h2';
}
const { heading = 'INDIEV is no longer accepting new projects', as = 'h2' } = Astro.props;
const Tag = as;
---
<section class="closure-notice" aria-label="Service status">
  <div class="main_container">
    <div class="closure-notice__card">
      <Tag class="closure-notice__title">{heading}</Tag>
      <p class="closure-notice__text">INDIEV has ceased operations. Thank you to every client and partner we worked with. The articles and service guides on this site remain available as a public resource.</p>
      <slot />
    </div>
  </div>
</section>
<style>
  .closure-notice {
    background-color: var(--color-pink-soft);
    padding: var(--space-6) 0;
  }
  .closure-notice__card {
    max-width: 760px;
    margin: 0 auto;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-5) var(--space-4);
    text-align: center;
  }
  .closure-notice__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0 0 var(--space-2);
  }
  .closure-notice__text {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }
  @media (max-width: 767px) {
    .closure-notice { padding: var(--space-5) 0; }
    .closure-notice__card { padding: var(--space-4) var(--space-3); }
    .closure-notice__title { font-size: var(--text-xl); }
    .closure-notice__text { font-size: var(--text-base); }
  }
</style>
