---
const services = [
  { href: '/sp/outsource-youtube-video-editing-services', label: 'YouTube video editing' },
  { href: '/sp/wedding-video-editing-services', label: 'Wedding video editing' },
  { href: '/sp/real-estate-video-editing-services', label: 'Real estate video editing' },
  { href: '/sp/outsource-video-editing-services', label: 'Outsource video editing' },
  { href: '/sp/white-label-video-editing-services', label: 'White label editing for agencies' },
  { href: '/sp/best-online-video-editing-service', label: 'Online video editing service' },
  { href: '/sp/social-media-video-editing-services', label: 'Social media & Reels editing' },
  { href: '/sp/corporate-video-editing-services', label: 'Corporate video editing' },
];
---
<section class="service_section">
<div class="main_container">
<div class="service_heading-block">
<h2 class="empowering_subtitle how_work_subtitle"><span class="empowering_subtitle_span"> What Video Editing Services </span><br/>Do We Offer?</h2>
<p class="text-block-2 ta-center"> Choose a service or combine several. All are available inside our unlimited video editing model.</p>
</div>
<div class="w-layout-grid links_grid">
{services.map((s) => (
<div class="price-item jc-left">
<div class="done-icon-container">
<div class="code-embed w-embed"><svg height="20" viewbox="0 0 24 24" width="20" xmlns="http://www.w3.org/2000/svg">
<path d="M0 0h24v24H0z" fill="none"></path>
<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"></path>
</svg></div>
</div>
<a class="footer_link" href={s.href}>{s.label}</a>
</div>
))}
</div>
<p class="text-block-2 ta-center" style="margin-top: 32px;"><a class="footer_link" href="/services"><strong>Browse all 35 video editing services →</strong></a></p>
</div>
</section>
