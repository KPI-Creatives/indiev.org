---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import SeoSection from '../components/SeoSection.astro';
import Empowering from '../components/Empowering.astro';
import Services from '../components/Services.astro';
import Pricing from '../components/Pricing.astro';
import SpecificCta from '../components/SpecificCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import YouWillGet from '../components/YouWillGet.astro';
import Faq from '../components/Faq.astro';
import AnyCta from '../components/AnyCta.astro';
import Consultation from '../components/Consultation.astro';
import Information from '../components/Information.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Unlimited Video Editing Services for YouTube & Shorts | Indiev"
  description="Unlimited video editing services from $24/day. Top editors for YouTube, Reels, Shorts, real estate and corporate video — unlimited revisions, 24–48h delivery."
>
  <Navbar />
  <div class="main">
    <Hero />
    <VideoSection />
    <SeoSection />
    <Empowering />
    <Services />
    <Pricing />
    <SpecificCta />
    <HowItWorks />
    <YouWillGet />
    <Faq />
    <AnyCta />
    <Consultation />
    <Information />
  </div>
  <script type="application/ld+json" is:inline>
{"@context":"https://schema.org","@type":"OfferCatalog","@id":"https://www.indiev.org#services","name":"Video Editing Services","itemListElement":[{"@type":"OfferCatalog","name":"Video editing & post-production"},{"@type":"OfferCatalog","name":"Product & promo video creation"},{"@type":"OfferCatalog","name":"YouTube editing (music/effects/subtitles)"},{"@type":"OfferCatalog","name":"Videography packages"}],"provider":{"@id":"https://www.indiev.org#org"}}
  </script>
  <script type="application/ld+json" is:inline>
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I send my raw video files to Indiev?","acceptedAnswer":{"@type":"Answer","text":"You can securely upload your footage through our platform. We accept popular formats via cloud storage links (Google Drive, Dropbox, WeTransfer) for a smooth workflow."}},{"@type":"Question","name":"What is the typical turnaround time for video editing?","acceptedAnswer":{"@type":"Answer","text":"Standard edits are delivered within 3–5 business days, depending on project complexity. Rush delivery is available for urgent requests."}},{"@type":"Question","name":"Are unlimited revisions really included?","acceptedAnswer":{"@type":"Answer","text":"Yes. We provide unlimited revisions to ensure your video meets expectations. Feedback cycles are quick, and changes are applied until you’re 100% satisfied."}},{"@type":"Question","name":"In what formats will I receive my finished video?","acceptedAnswer":{"@type":"Answer","text":"Final videos are delivered in MP4 (H.264) optimized for YouTube, Instagram, TikTok, or other platforms you specify. Additional formats are available upon request."}},{"@type":"Question","name":"Do you edit YouTube videos with music, effects, and subtitles?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. Our team adds licensed music, sound effects, motion graphics, and subtitles to enhance engagement and retention on YouTube."}},{"@type":"Question","name":"Can you create product or promo videos?","acceptedAnswer":{"@type":"Answer","text":"Yes. We produce polished product and promotional videos, including social media ads, branded content, and marketing clips tailored to your goals."}}]}
  </script>
  <Footer />
</Base>
