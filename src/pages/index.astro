---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import SeoSection from '../components/SeoSection.astro';
import Empowering from '../components/Empowering.astro';
import Services from '../components/Services.astro';
import HowItWorks from '../components/HowItWorks.astro';
import YouWillGet from '../components/YouWillGet.astro';
import Faq from '../components/Faq.astro';
import ClosureNotice from '../components/ClosureNotice.astro';
import Information from '../components/Information.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Professional Video Editing Services: Guides and Insights | Indiev"
  description="Indiev was a Los Angeles video editing company for YouTube, real estate, weddings and brands. INDIEV has ceased operations; its video editing guides remain available."
>
  <Navbar />
  <div class="main">
    <Hero />
    <VideoSection />
    <SeoSection />
    <Empowering />
    <Services />
    <ClosureNotice />
    <HowItWorks />
    <YouWillGet />
    <Faq />
    <Information />
  </div>
  <script type="application/ld+json" is:inline>
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is INDIEV still operating?","acceptedAnswer":{"@type":"Answer","text":"No. INDIEV has ceased operations and is no longer accepting new projects. The articles and guides on this site remain available as a public resource."}},{"@type":"Question","name":"What types of videos did INDIEV edit?","acceptedAnswer":{"@type":"Answer","text":"INDIEV edited YouTube videos and podcasts, Reels, Shorts and TikTok clips, real estate tours, wedding films, and corporate, product and promotional videos."}},{"@type":"Question","name":"How did the INDIEV editing process work?","acceptedAnswer":{"@type":"Answer","text":"Projects started with a brief, followed by professional editing, art-director review, client feedback in Frame.io, and final delivery."}},{"@type":"Question","name":"How should video footage be kept confidential and secure?","acceptedAnswer":{"@type":"Answer","text":"Use secure file transfer and access-controlled cloud storage, and share review links only with the people who need them."}}]}
  </script>
  <Footer />
</Base>
