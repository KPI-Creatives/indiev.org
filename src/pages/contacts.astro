---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const extraHead = `<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "url": "https://www.indiev.org/contact",
  "name": "Contact Indiev Video Editors",
  "description": "Contact Indiev for professional video editing and post-production. Business hours Mon–Fri 08:00–17:00 in Venice, CA.",
  "publisher": { "@id": "https://www.indiev.org#org" }
}</script>
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.indiev.org#org",
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "telephone": "+1-747-677-1203",
      "areaServed": "US",
      "availableLanguage": ["English"]
    }
  ]
}</script>`;
---
<Base
  title="Contact Indiev — Video Editing Services in Venice, CA"
  description={'Get in touch with Indiev Video Editors in Venice, CA. Call +1 (747) 677-1203 for video editing, YouTube edits, product promos, and professional post-production.'}
  canonical="https://www.indiev.org/contacts"
>
  <Navbar />
<main class="main">
<section class="contacts">
<div class="main_container">
<h1 class="contacts_title"><span class="contacts_title_span">Contact us and </span>transform your videos</h1>
<div class="form_container">
<div class="price_form contact_form w-form" id="price-form">
<form data-name="Sales Pitch Form" data-wf-element-id="37734790-e021-3843-99c7-6a8f49e8f7e2" data-wf-page-id="664e1ac6081a122d43c0b510" method="get" name="wf-form-Sales-Pitch-Form">
<input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;height:0;width:0;border:0;padding:0" aria-hidden="true"/>
<div class="form_field-wrapper"><label class="form_field-label" for="price-name">Name*</label><input class="form_input w-input" data-name="Name 2" id="price-name" maxlength="256" name="Name-2" placeholder="Name" required="" type="text"/>
<div class="error_message" id="name-error"></div>
<div class="check_mark" id="name-check"><img alt="check mark" class="check_image" loading="lazy" sizes="(max-width: 657px) 100vw, 657px" src="/images/checkmark-transparent-6-removebg-preview.png" srcset="/images/checkmark-transparent-6-removebg-preview-p-500.png 500w, /images/checkmark-transparent-6-removebg-preview.png 657w"/></div>
</div>
<div class="form_field-wrapper"><label class="form_field-label" for="price-email">Email*</label><input class="form_input w-input" data-name="Name 2" id="price-email" maxlength="256" name="Name-2" placeholder="Email" required="" type="text"/>
<div class="error_message" id="email-error"></div>
<div class="check_mark" id="email-check"><img alt="check mark" class="check_image" loading="lazy" sizes="(max-width: 657px) 100vw, 657px" src="/images/checkmark-transparent-6-removebg-preview.png" srcset="/images/checkmark-transparent-6-removebg-preview-p-500.png 500w, /images/checkmark-transparent-6-removebg-preview.png 657w"/></div>
</div>
<div class="form_field-wrapper"><label class="form_field-label" for="price-phone">Phone*</label><input class="form_input w-input" data-name="Name 2" id="price-phone" maxlength="256" name="Name-2" placeholder="+1" required="" type="text"/>
<div class="error_message" id="phone-error"></div>
<div class="check_mark" id="phone-check"><img alt="check mark" class="check_image" loading="lazy" sizes="(max-width: 657px) 100vw, 657px" src="/images/checkmark-transparent-6-removebg-preview.png" srcset="/images/checkmark-transparent-6-removebg-preview-p-500.png 500w, /images/checkmark-transparent-6-removebg-preview.png 657w"/></div>
</div>
<div class="form_field-wrapper"><label class="field-label-5" for="price-message">Message</label><textarea class="form_input is-text-area w-input" data-name="Message 2" id="price-message" maxlength="5000" name="Message-2" placeholder="Type your message..."></textarea></div><input class="button_form saledesk_button_form w-button" data-wait="Please wait..." id="price-submmit-button" type="submit" value="Submit"/>
</form>
<div class="w-form-done">
<div>Thank you! Your submission has been received!</div>
</div>
<div class="w-form-fail">
<div>Oops! Something went wrong while submitting the form.</div>
</div>
</div>

<ul class="contacts_list w-list-unstyled" role="list">
<li class="contacts_item">
<div class="contacts_icon_container">
<div class="contacts_icon w-embed"><svg fill="none" height="80" viewbox="0 0 56 80" width="56" xmlns="http://www.w3.org/2000/svg">
<path d="M28 0C12.52 0 0 12.52 0 28C0 49 28 80 28 80C28 80 56 49 56 28C56 12.52 43.48 0 28 0ZM28 38C22.48 38 18 33.52 18 28C18 22.48 22.48 18 28 18C33.52 18 38 22.48 38 28C38 33.52 33.52 38 28 38Z" fill="#7B5BE9"></path>
</svg></div>
</div>
<div class="phone-text-container">
<a class="link-5" href="https://www.google.com/maps?cid=6481826325447191756" target="_blank">695 Santa Clara Ave, <br/>Venice, CA 90291,<br/> United States</a>
<a class="contacts_item_text phone-contact-link" href="tel:+17476771203">Phone:<br/>1 (747) 677-1203 <br/>‍</a>
</div>
</li>
<li class="contacts_item">
<a class="contacts_call w-inline-block" data-w-id="4b9ac6e8-c600-44f3-e532-a96ae4db5ab7" href="/calendly">
<div class="contacts_icon_container">
<div class="contacts_icon w-embed"><svg fill="none" height="64" viewbox="0 0 78 64" width="78" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_1367_4085)">
<path d="M44.125 31.946L51.7291 40.5987L61.955 47.1034L63.7338 32.0006L61.955 17.2384L51.5332 22.9526L44.125 31.946Z" fill="#00832D"></path>
<path d="M0 45.6978V58.5675C0 61.5061 2.39606 63.892 5.34848 63.892H18.2764L20.9534 54.1679L18.2764 45.6978L9.40692 43.0328L0.000304688 45.6978H0Z" fill="#0066DA"></path>
<path d="M18.2764 0L0 18.1942L9.40753 20.8528L18.2764 18.1942L20.9046 9.83932L18.2764 0Z" fill="#E94235"></path>
<path d="M0 45.7039H18.2764V18.1936H0.000304688L0 45.7039Z" fill="#2684FC"></path>
<path d="M73.6304 7.7037L61.9551 17.2388V47.1034L73.6785 56.6755C75.4335 58.0441 78.0008 56.7969 78.0008 54.576V9.7608C78.0008 7.51534 75.3723 6.27416 73.6301 7.704" fill="#00AC47"></path>
<path d="M44.1254 31.946V45.6979H18.2764V63.8921H56.6073C59.5597 63.8921 61.9555 61.5062 61.9555 58.5676V47.1034L44.1254 31.946Z" fill="#00AC47"></path>
<path d="M56.6073 0H18.2764V18.1942H44.1255V31.946L61.9558 17.2381V5.32474C61.9558 2.38559 59.5597 0.000303318 56.6073 0.000303318" fill="#FFBA00"></path>
</g>
<defs>
<clippath id="clip0_1367_4085">
<rect fill="white" height="64" width="78"></rect>
</clippath>
</defs>
</svg></div>
</div>
<div class="email_text"> <strong>Schedule free</strong><br/> 30-Min Call<br/></div>
</a>
</li>
<li class="contacts_item">
<a class="contacts_call w-inline-block" href="mailto:inbox@indiev.org">
<div class="contacts_icon_container">
<div class="contacts_icon w-embed"><svg fill="none" height="96" viewbox="0 0 96 96" width="96" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_1367_4076)">
<path d="M80 16H16C11.6 16 8.04 19.6 8.04 24L8 72C8 76.4 11.6 80 16 80H80C84.4 80 88 76.4 88 72V24C88 19.6 84.4 16 80 16ZM80 72H16V32L48 52L80 32V72ZM48 44L16 24H80L48 44Z" fill="#7B5BE9"></path>
</g>
<defs>
<clippath id="clip0_1367_4076">
<rect fill="white" height="96" width="96"></rect>
</clippath>
</defs>
</svg></div>
</div>
<div class="email_text"> <strong>Direct email</strong><br/>inbox@indiev.org</div>
</a>
</li>
</ul>
</div>
<div class="contact_form_cod w-embed w-script">
<style>
.disable {
  background-color: #ccc; 
  color: #fff; 
  cursor: not-allowed; 
  opacity: 0.6;
  pointer-events: none;
}
</style>

</div>
</div>
</section>
<section class="contacts_map">
<div class="maps_icon_container"><img alt="map point" class="map_photo" loading="lazy" src="/images/map.png"/></div>
</section>
</main>
  <Footer />
  <Fragment set:html={extraHead} />
</Base>
