---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import AboutHero from '../components/AboutHero.astro';
import AboutMission from '../components/AboutMission.astro';
import AboutBlack from '../components/AboutBlack.astro';
import AboutTeam from '../components/AboutTeam.astro';
import ClosureNotice from '../components/ClosureNotice.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Video Editing Company in Venice, CA — About Indiev Video Editors"
  description="Indiev was a video editing company and post-production team in Venice, Los Angeles, founded by Yaro Korets and Dmytro Pavlenko. INDIEV has ceased operations."
  canonical="https://www.indiev.org/about"
>
  <Navbar />
  <div class="main">
    <AboutHero />
    <AboutMission />
    <AboutBlack />
    <AboutTeam />
    <ClosureNotice />
  </div>
  <Footer />
</Base>
