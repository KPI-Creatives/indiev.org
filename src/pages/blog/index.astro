---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Video Editing Blog — Trends, Costs & Guides | Indiev"
  description="Guides and insights from the Indiev editing team: video editing trends, real costs, AI tools and workflows for creators and businesses."
  canonical="https://www.indiev.org/blog"
>
  <Navbar />
  <div class="main">
    <section class="information blog-article">
      <div class="main_container">
        <h1 class="information_title">Indiev Blog</h1>
        <p class="information_text">Guides and insights from a team that edits hundreds of videos every month.</p>
        <ol class="information_list">
          <li class="information_item">
            <h2 class="information_subtitle"><a href="/blog/video-editing-2026">Video Editing in 2026: Trends, Costs, and AI Tools</a></h2>
            <p class="information_item_text">The 5 trends that define editing this year, real market costs from $100 per video, and the AI tools professional editors actually use. <a href="/blog/video-editing-2026">Read the article →</a></p>
          </li>
        </ol>
      </div>
    </section>
  </div>
  <Footer />
</Base>
